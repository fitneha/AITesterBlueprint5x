# The app searches upward for the repository-root .env. Keep secrets server-side.
# Choose one configured provider or set LLM_PROVIDER explicitly.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=
# Or use Ollama:
# LLM_PROVIDER=ollama
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=

# Jira is optional for manual-only generation.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_TOKEN=

# Optional external connectors; supply authorized access tokens only.
GOOGLE_ACCESS_TOKEN=
NOTION_TOKEN=
MS_GRAPH_ACCESS_TOKEN=
DOCUMENT_ALLOWED_HOSTS=

AI_TEST_CASE_GENERATOR_PORT=3003
MAX_UPLOAD_MB=8
