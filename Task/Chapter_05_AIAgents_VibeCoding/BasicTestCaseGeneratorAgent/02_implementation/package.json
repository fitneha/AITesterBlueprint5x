{
  "name": "ai-test-case-generator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "node --watch src/backend/start.js",
    "dev:frontend": "vite --config src/frontend/vite.config.js",
    "build": "vite build --config src/frontend/vite.config.js",
    "start": "node src/backend/start.js",
    "test": "node --test src/backend/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "mammoth": "^1.9.0",
    "multer": "^2.0.2",
    "pdf-parse": "1.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.3",
    "remark-gfm": "^4.0.0",
    "word-extractor": "^1.0.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.0.7"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
